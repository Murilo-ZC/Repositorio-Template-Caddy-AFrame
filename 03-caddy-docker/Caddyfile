{
	# Portas usadas DENTRO do contêiner. São as mesmas publicadas no
	# docker-compose.yml, assim o redirecionamento HTTP -> HTTPS acerta a porta.
	http_port 8080
	https_port 8443

	# O Caddy não consegue instalar o certificado no sistema de dentro do
	# contêiner; a instalação na sua máquina é feita à mão (ver README).
	skip_install_trust
}

# Usar um nome (localhost) em vez de só a porta faz o Caddy ativar o HTTPS
# automaticamente, com um certificado emitido pela CA local dele.
localhost {
	root * /srv
	file_server

	# Obriga o navegador a revalidar os arquivos a cada acesso:
	# editou o HTML, recarregou a página, viu a mudança.
	header Cache-Control "no-cache"
}
